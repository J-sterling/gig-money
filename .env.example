# Copy to .env and fill in. .env is gitignored.
# Sandbox only: the app refuses to start with any other value.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Written by `npm run webhook:register -- <public-url>`
PAYPAL_WEBHOOK_ID=
PORT=3000
# Signs the demo-workspace cookie. Set a long random value on any shared deploy:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Share of income the tax set-aside estimate keeps back (an estimate, not tax advice)
TAX_SET_ASIDE_RATE=0.25
# Where the database, event log and model-usage file go (a persistent disk on Render)
# DATA_DIR=var
# Require this password on every page except /health and the PayPal webhook (set it on any public deploy)
# DEMO_PASSWORD=
# For scripts/render.sh: scripts/key-from-vault.sh render_api_key RENDER_API_KEY
# RENDER_API_KEY=
# Public URL of this app, used for the order return link (defaults to http://localhost:PORT)
# PUBLIC_URL=

# AI model through OpenRouter's free tier (runs on OpenRouter's providers, not locally).
# Get a free key at openrouter.ai. Locally: scripts/key-from-vault.sh openrouter OPENROUTER_API_KEY
OPENROUTER_API_KEY=
# Comma-separated: OpenRouter falls back to the next one if a free endpoint is down (max 3)
MODEL=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free
# Model calls allowed per UTC day, kept below OpenRouter's free cap
MODEL_DAILY_LIMIT=40
# Give up on a slow free model after this many ms (the app then shows a saved draft)
MODEL_TIMEOUT_MS=20000
# Reasoning effort: none is fastest and enough for drafting
MODEL_REASONING=none
