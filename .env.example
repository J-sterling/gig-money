# Copy to .env and fill in. .env is gitignored.
# Sandbox only: the app refuses to start with any other value.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Written by `npm run webhook:register -- <public-url>`
PAYPAL_WEBHOOK_ID=
PORT=3000
# Public URL of this app, used for the order return link (defaults to http://localhost:PORT)
# PUBLIC_URL=

# AI model through OpenRouter's free tier (runs on OpenRouter's providers, not locally).
# Get a free key at openrouter.ai. Locally: scripts/key-from-vault.sh openrouter OPENROUTER_API_KEY
OPENROUTER_API_KEY=
MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Model calls allowed per UTC day, kept below OpenRouter's free cap
MODEL_DAILY_LIMIT=40
